    %store/vec4 v0xcb7430_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xcb75d0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xcb75d0_0, 0, 1;
    %delay 260, 0;
    %vpi_call 2 15 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0xc6df50;
T_3 ;
