 .timescale 0 0;
v0xcb7430_0 .var "clk", 0 0;
v0xcb7500_0 .net "count", 7 0, v0xcb7230_0;  1 drivers
v0xcb75d0_0 .var "rst", 0 0;
E_0xca4e10 .event anyedge, v0xcb7230_0;
S_0xca5a50 .scope module, "counter1" "counter" 2 5, 3 1 0, S_0xc6df50;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 8 "count";
v0xca5ca0_0 .net "clk", 0 0, v0xcb7430_0;  1 drivers
v0xcb7230_0 .var "count", 7 0;
v0xcb7310_0 .net "rst", 0 0, v0xcb75d0_0;  1 drivers
E_0xca4dd0/0 .event negedge, v0xcb7310_0;
E_0xca4dd0/1 .event posedge, v0xca5ca0_0;
E_0xca4dd0 .event/or E_0xca4dd0/0, E_0xca4dd0/1;
    .scope S_0xca5a50;
T_0 ;
    %wait E_0xca4dd0;
    %load/vec4 v0xcb7310_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0xcb7230_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0xcb7230_0;
    %addi 1, 0, 8;
    %assign/vec4 v0xcb7230_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0xc6df50;
T_1 ;
    %delay 5, 0;
    %load/vec4 v0xcb7430_0;
    %inv;
    %store/vec4 v0xcb7430_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0xc6df50;
T_2 ;
