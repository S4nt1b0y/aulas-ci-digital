VERSION 5.5 ;
NAMESCASESENSITIVE ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN mac_lab9_top ;

SCANCHAINS 1 ;
  - mac_chain_seg1_clk_rising 
    + PARTITION p_clk_rising 
      MAXBITS 40
    + START PIN scan_in
    + FLOATING 
       dut/busy_reg ( IN SI ) ( OUT QN ) 
       dut/count_reg[0] ( IN SI ) ( OUT Q ) 
       dut/count_reg[1] ( IN SI ) ( OUT Q ) 
       dut/count_reg[2] ( IN SI ) ( OUT Q ) 
       dut/count_reg[3] ( IN SI ) ( OUT Q ) 
       dut/count_reg[4] ( IN SI ) ( OUT Q ) 
       dut/count_reg[5] ( IN SI ) ( OUT Q ) 
       dut/count_reg[6] ( IN SI ) ( OUT Q ) 
       dut/count_reg[7] ( IN SI ) ( OUT Q ) 
       dut/count_reg[8] ( IN SI ) ( OUT Q ) 
       dut/count_reg[9] ( IN SI ) ( OUT Q ) 
       dut/count_reg[10] ( IN SI ) ( OUT Q ) 
       dut/done_reg ( IN SI ) ( OUT Q ) 
       dut/result_reg[0] ( IN SI ) ( OUT QN ) 
       dut/result_reg[1] ( IN SI ) ( OUT QN ) 
       dut/result_reg[2] ( IN SI ) ( OUT QN ) 
       dut/result_reg[3] ( IN SI ) ( OUT Q ) 
       dut/result_reg[4] ( IN SI ) ( OUT Q ) 
       dut/result_reg[5] ( IN SI ) ( OUT QN ) 
       dut/result_reg[6] ( IN SI ) ( OUT Q ) 
       dut/result_reg[7] ( IN SI ) ( OUT Q ) 
       dut/result_reg[8] ( IN SI ) ( OUT Q ) 
       dut/result_reg[9] ( IN SI ) ( OUT Q ) 
       dut/result_reg[10] ( IN SI ) ( OUT Q ) 
       dut/result_reg[11] ( IN SI ) ( OUT Q ) 
       dut/result_reg[12] ( IN SI ) ( OUT Q ) 
       dut/result_reg[13] ( IN SI ) ( OUT Q ) 
       dut/result_reg[14] ( IN SI ) ( OUT Q ) 
       dut/result_reg[15] ( IN SI ) ( OUT Q ) 
       dut/result_reg[16] ( IN SI ) ( OUT Q ) 
       dut/result_reg[17] ( IN SI ) ( OUT Q ) 
       dut/result_reg[18] ( IN SI ) ( OUT Q ) 
       dut/result_reg[19] ( IN SI ) ( OUT Q ) 
       dut/result_reg[20] ( IN SI ) ( OUT Q ) 
       dut/result_reg[21] ( IN SI ) ( OUT Q ) 
       dut/result_reg[22] ( IN SI ) ( OUT Q ) 
       dut/result_reg[23] ( IN SI ) ( OUT Q ) 
       dut/result_reg[24] ( IN SI ) ( OUT Q ) 
       dut/result_reg[25] ( IN SI ) ( OUT Q ) 
       dut/result_reg[26] ( IN SI ) ( OUT Q ) 
    + STOP PIN scan_out
;

END SCANCHAINS 
END DESIGN 

